datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id     Int     @id @default(autoincrement())
  name   String  @db.VarChar(32) // 用户名称
  py     String  @db.VarChar(32) // 拼音信息
  tel    String  @db.VarChar(11) // 手机号码
  frame  Int // 所属组织
  role   Int // 所属角色
  user   String  @db.VarChar(32) // 登陆账号
  pwd    String  @db.VarChar(32) // 登陆密码 (MD5)
  img    String  @db.Text // 用户头像
  token  String? @default("") @db.VarChar(32) // 秘钥信息
  expire Int // 秘钥时效
  data   String  @db.VarChar(256) // 备注信息
  more   String  @db.Text // 扩展信息

  @@map("is_user")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(32) // 角色名称
  data String @db.VarChar(256) // 备注信息
  root String @db.Text // 功能数据
  auth String @db.Text // 数据权限

  @@map("is_role")
}

model Menu {
  id       Int     @id @default(autoincrement())
  pid      Int // 所属菜单
  name     String  @db.VarChar(32) // 菜单名称
  key      String  @db.VarChar(32) // 菜单标识
  model    Boolean // 菜单模式[0:标签模式|1:新页模式]
  type     Boolean // 菜单类型[0:独立菜单|1:附属菜单]
  resource String  @db.VarChar(128) // 菜单地址
  sort     Int?    @default(0) // 菜单排序
  ico      String  @db.VarChar(32) // 菜单图标
  root     String  @db.VarChar(32) // 权限标识
  data     String  @db.VarChar(256) // 备注信息

  @@map("is_menu")
}

model Code {
  id   Int     @id @default(autoincrement())
  name String  @db.VarChar(32) // 条码名称
  info String  @db.Text // 条码内容
  type Boolean // 条码类型[0:条形码|1:二维码]
  data String? @db.VarChar(256) // 备注信息

  @@map("is_code")
}

model Sys {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(32) // 配置名称
  info String @db.Text // 配置内容
  data String @db.VarChar(256) // 备注信息

  @@map("is_sys")
}

model Customer {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(32) // 客户名称
  py       String  @db.VarChar(32) // 拼音信息
  number   String  @db.VarChar(32) // 客户编号
  frame    Int // 所属组织
  user     Int // 所属用户
  category String  @db.VarChar(32) // 客户类别
  grade    String  @db.VarChar(32) // 客户等级
  bank     String  @db.VarChar(32) // 开户银行
  account  String  @db.VarChar(64) // 银行账号
  tax      String  @db.VarChar(64) // 纳税号码
  data     String  @db.VarChar(256) // 备注信息
  contacts String  @db.Text // 联系资料
  balance  Decimal @default(0.0000) @db.Decimal(16, 4) // 应收款余额
  more     String  @db.Text // 扩展信息

  @@map("is_customer")
}

model Supplier {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(32) // 供应商名称
  py       String  @db.VarChar(32) // 拼音信息
  number   String  @db.VarChar(32) // 供应商编号
  frame    Int // 所属组织
  user     Int // 所属用户
  category String  @db.VarChar(32) // 供应商类别
  rate     Decimal @db.Decimal(5, 2) // 增值税税率
  bank     String  @db.VarChar(32) // 开户银行
  account  String  @db.VarChar(64) // 银行账号
  tax      String  @db.VarChar(64) // 纳税号码
  data     String  @db.VarChar(256) // 备注信息
  contacts String  @db.Text // 联系资料
  balance  Decimal @default(0.0000) @db.Decimal(16, 4) // 应付款余额
  more     String  @db.Text // 扩展信息

  @@map("is_supplier")
}

model Goods {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(32) // 商品名称
  py        String  @db.VarChar(32) // 拼音信息
  number    String  @db.VarChar(32) // 商品编号
  spec      String  @db.VarChar(32) // 规格型号
  category  Int // 商品类别
  brand     String  @db.VarChar(32) // 商品品牌
  unit      String  @db.VarChar(32) // 商品单位
  buy       Decimal @db.Decimal(12, 4) // 采购价格
  sell      Decimal @db.Decimal(12, 4) // 销售价格
  code      String  @db.VarChar(64) // 商品条码
  location  String  @db.VarChar(64) // 商品货位
  stock     Decimal @db.Decimal(12, 4) // 库存阈值
  type      Boolean // 产品类型
  data      String  @db.VarChar(256) // 备注信息
  imgs      String  @db.Text // 商品图像
  details   String  @db.Text // 图文详情
  units     String  @db.Text // 多单位配置
  strategy  String  @db.Text // 折扣策略
  serial    Boolean @default(false) // 序列产品
  batch     Boolean @default(false) // 批次产品
  validity  Boolean @default(false) // 有效期
  protect   Int     @default(0) @db.SmallInt // 保质期
  threshold Int     @default(0) @db.SmallInt // 预警阀值
  more      String  @db.Text // 扩展信息

  @@map("is_goods")
}

model Warehouse {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(32) // 仓库名称
  number   String @db.VarChar(32) // 仓库编号
  frame    Int // 所属组织
  contacts String @db.VarChar(32) // 联系人员
  tel      String @db.VarChar(32) // 联系电话
  add      String @db.VarChar(64) // 仓库地址
  data     String @db.VarChar(256) // 备注信息

  @@map("is_warehouse")
}

model Account {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(32) // 账户名称
  number  String  @db.VarChar(32) // 账户编号
  frame   Int // 所属组织
  time    Int // 余额日期
  initial Decimal @db.Decimal(16, 4) // 期初余额
  balance Decimal @default(0.0000) @db.Decimal(16, 4) // 账户余额
  data    String? @default("") @db.VarChar(256) // 备注信息

  @@map("is_account")
}

model Room {
  id        Int     @id @default(autoincrement())
  warehouse Int // 所属仓库
  goods     Int // 所属商品
  attr      String  @db.VarChar(64) // 辅助属性
  nums      Decimal @db.Decimal(12, 4) // 库存数量

  @@map("is_room")
}

model Batch {
  id        Int     @id @default(autoincrement())
  room      Int // 所属仓储
  warehouse Int // 所属仓库
  goods     Int // 所属商品
  number    String  @db.VarChar(64) // 批次号
  time      Int?    @default(0) // 生产日期
  nums      Decimal @db.Decimal(12, 4) // 库存数量

  @@map("is_batch")
}

model Sell {
  id        Int     @id @default(autoincrement())
  source    Int // 关联单据|SOR
  frame     Int // 所属组织
  customer  Int // 客户
  time      Int // 单据时间
  number    String  @db.VarChar(32) // 单据编号
  total     Decimal @db.Decimal(16, 4) // 单据金额
  actual    Decimal @db.Decimal(16, 4) // 实际金额
  money     Decimal @db.Decimal(16, 4) // 实收金额
  cost      Decimal @db.Decimal(16, 4) // 单据费用
  account   Int?    @default(0) // 结算账户
  people    Int?    @default(0) // 关联人员
  logistics String? @db.Text // 物流信息
  file      String? @db.Text // 单据附件
  data      String? @default("") @db.VarChar(256) // 备注信息
  more      String? @db.Text // 扩展信息
  examine   Boolean // 审核状态
  nucleus   Boolean // 核销状态
  cse       Boolean // 费用状态
  invoice   Boolean // 发票状态
  check     Boolean // 核对状态
  user      Int // 制单人

  @@map("is_sell")
}

model SellInfo {
  id        Int     @id @default(autoincrement())
  pid       Int // 所属单据
  source    Int?    @default(0) // 关联单据|SOR_INFO
  goods     Int // 所属商品
  attr      String? @default("") @db.VarChar(64) // 辅助属性
  unit      String? @default("") @db.VarChar(32) // 商品单位
  warehouse Int?    @default(0) // 所属仓库
  batch     String? @default("") @db.VarChar(64) // 批次号
  mfd       String? @default("") @db.VarChar(32) // 生产日期
  price     Decimal @db.Decimal(12, 4) // 单价
  nums      Decimal @db.Decimal(12, 4) // 数量
  serial    String? @db.Text // 序列号
  retreat   Decimal @default(0.0000) @db.Decimal(12, 4) // 退货数量
  discount  Decimal @default(0.00) @db.Decimal(5, 2) // 折扣率
  dsc       Decimal @default(0.0000) @db.Decimal(16, 4) // 折扣额
  total     Decimal @db.Decimal(16, 4) // 金额
  tax       Decimal @default(0.00) @db.Decimal(5, 2) // 税率
  tat       Decimal @default(0.0000) @db.Decimal(16, 4) // 税额
  tpt       Decimal @db.Decimal(16, 4) // 价税合计
  data      String? @default("") @db.VarChar(256) // 备注信息

  @@map("is_sell_info")
}

model Imy {
  id       Int     @id @default(autoincrement())
  frame    Int // 所属组织
  customer Int // 客户
  time     Int // 单据时间
  number   String  @db.VarChar(32) // 单据编号
  total    Decimal @db.Decimal(16, 4) // 单据金额
  people   Int?    @default(0) // 关联人员
  file     String? @db.Text // 单据附件
  data     String? @default("") @db.VarChar(256) // 备注信息
  more     String? @db.Text // 扩展信息
  examine  Boolean // 审核状态
  nucleus  Boolean // 核销状态
  user     Int // 制单人

  @@map("is_imy")
}

model Ice {
  id       Int     @id @default(autoincrement())
  frame    Int // 所属组织
  customer Int?    @default(0) // 客户
  time     Int // 单据时间
  number   String  @db.VarChar(32) // 单据编号
  total    Decimal @db.Decimal(16, 4) // 单据金额
  actual   Decimal @db.Decimal(16, 4) // 实际金额
  money    Decimal @db.Decimal(16, 4) // 实收金额
  account  Int // 结算账户
  people   Int?    @default(0) // 关联人员
  file     String? @db.Text // 单据附件
  data     String? @default("") @db.VarChar(256) // 备注信息
  more     String? @db.Text // 扩展信息
  examine  Boolean // 审核状态
  nucleus  Boolean // 核销状态
  user     Int // 制单人

  @@map("is_ice")
}

model Buy {
  id        Int     @id @default(autoincrement())
  source    Int // 关联单据|BOR
  frame     Int // 所属组织
  supplier  Int // 供应商
  time      Int // 单据时间
  number    String  @db.VarChar(32) // 单据编号
  total     Decimal @db.Decimal(16, 4) // 单据金额
  actual    Decimal @db.Decimal(16, 4) // 实际金额
  money     Decimal @db.Decimal(16, 4) // 实付金额
  cost      Decimal @db.Decimal(16, 4) // 单据费用
  account   Int?    @default(0) // 结算账户
  people    Int?    @default(0) // 关联人员
  logistics String? @db.Text // 物流信息
  file      String? @db.Text // 单据附件
  data      String? @default("") @db.VarChar(256) // 备注信息
  more      String? @db.Text // 扩展信息
  examine   Boolean // 审核状态
  nucleus   Boolean // 核销状态
  cse       Boolean // 费用状态
  invoice   Boolean // 发票状态
  check     Boolean // 核对状态
  user      Int // 制单人

  @@map("is_buy")
}

model Bre {
  id        Int     @id @default(autoincrement())
  source    Int // 关联单据|BUY
  frame     Int // 所属组织
  supplier  Int // 供应商
  time      Int // 单据时间
  number    String  @db.VarChar(32) // 单据编号
  total     Decimal @db.Decimal(16, 4) // 单据金额
  actual    Decimal @db.Decimal(16, 4) // 实际金额
  money     Decimal @db.Decimal(16, 4) // 实收金额
  cost      Decimal @db.Decimal(16, 4) // 单据费用
  account   Int?    @default(0) // 结算账户
  people    Int?    @default(0) // 关联人员
  logistics String? @db.Text // 物流信息
  file      String? @db.Text // 单据附件
  data      String? @default("") @db.VarChar(256) // 备注信息
  more      String? @db.Text // 扩展信息
  examine   Boolean // 审核状态
  nucleus   Boolean // 核销状态
  cse       Boolean // 费用状态
  invoice   Boolean // 发票状态
  check     Boolean // 核对状态
  user      Int // 制单人

  @@map("is_bre")
}

model BreInfo {
  id        Int     @id @default(autoincrement())
  pid       Int // 所属单据
  source    Int?    @default(0) // 关联单据|BUY_INFO
  goods     Int // 所属商品
  attr      String? @default("") @db.VarChar(64) // 辅助属性
  unit      String? @default("") @db.VarChar(32) // 商品单位
  warehouse Int?    @default(0) // 所属仓库
  batch     String? @default("") @db.VarChar(64) // 批次号
  mfd       String? @default("") @db.VarChar(32) // 生产日期
  price     Decimal @db.Decimal(12, 4) // 单价
  nums      Decimal @db.Decimal(12, 4) // 数量
  serial    String? @db.Text // 序列号
  discount  Decimal @default(0.00) @db.Decimal(5, 2) // 折扣率
  dsc       Decimal @default(0.0000) @db.Decimal(16, 4) // 折扣额
  total     Decimal @db.Decimal(16, 4) // 金额
  tax       Decimal @default(0.00) @db.Decimal(5, 2) // 税率
  tat       Decimal @default(0.0000) @db.Decimal(16, 4) // 税额
  tpt       Decimal @db.Decimal(16, 4) // 价税合计
  data      String? @default("") @db.VarChar(256) // 备注信息

  @@map("is_bre_info")
}

model Sre {
  id        Int     @id @default(autoincrement())
  source    Int // 关联单据|SELL
  frame     Int // 所属组织
  customer  Int // 客户
  time      Int // 单据时间
  number    String  @db.VarChar(32) // 单据编号
  total     Decimal @db.Decimal(16, 4) // 单据金额
  actual    Decimal @db.Decimal(16, 4) // 实际金额
  money     Decimal @db.Decimal(16, 4) // 实付金额
  cost      Decimal @db.Decimal(16, 4) // 单据费用
  account   Int?    @default(0) // 结算账户
  people    Int?    @default(0) // 关联人员
  logistics String? @db.Text // 物流信息
  file      String? @db.Text // 单据附件
  data      String? @default("") @db.VarChar(256) // 备注信息
  more      String? @db.Text // 扩展信息
  examine   Boolean // 审核状态
  nucleus   Boolean // 核销状态
  cse       Boolean // 费用状态
  invoice   Boolean // 发票状态
  check     Boolean // 核对状态
  user      Int // 制单人

  @@map("is_sre")
}

model Omy {
  id       Int     @id @default(autoincrement())
  frame    Int // 所属组织
  supplier Int // 供应商
  time     Int // 单据时间
  number   String  @db.VarChar(32) // 单据编号
  total    Decimal @db.Decimal(16, 4) // 单据金额
  people   Int?    @default(0) // 关联人员
  file     String? @db.Text // 单据附件
  data     String? @default("") @db.VarChar(256) // 备注信息
  more     String? @db.Text // 扩展信息
  examine  Boolean // 审核状态
  nucleus  Boolean // 核销状态
  user     Int // 制单人

  @@map("is_omy")
}

model Summary {
  id        Int     @id @default(autoincrement())
  pid       Int // 仓储详情
  type      String  @db.VarChar(32) // 单据类型
  class     Int // 所属单据
  info      Int // 所属详情
  time      Int // 单据时间
  goods     Int // 所属商品
  attr      String  @db.VarChar(64) // 辅助属性
  warehouse Int // 所属仓库
  batch     String  @db.VarChar(64) // 批次
  mfd       Int // 生产日期
  serial    String  @db.Text // 序列号
  direction Boolean // 方向[0:出|1:入]
  price     Decimal @db.Decimal(12, 4) // 基础单价
  nums      Decimal @db.Decimal(12, 4) // 基础数量
  uct       Decimal @db.Decimal(12, 4) // 单位成本
  bct       Decimal @db.Decimal(12, 4) // 基础成本
  exist     String  @db.Text // 结存组
  balance   String  @db.Text // 结余组
  handle    Decimal @db.Decimal(12, 4) // 先进先出

  @@map("is_summary")
}

model Category {
  id   Int    @id @default(autoincrement())
  pid  Int // 所属类别
  name String @db.VarChar(32) // 类别名称
  sort Int?   @default(0) // 类别排序
  data String @db.VarChar(256) // 备注信息

  @@map("is_category")
}

model Frame {
  id   Int    @id @default(autoincrement())
  pid  Int // 所属ID
  name String @db.VarChar(32) // 组织名称
  sort Int?   @default(0) // 组织排序
  data String @db.VarChar(256) // 备注信息

  @@map("is_frame")
}

model Iet {
  id   Int     @id @default(autoincrement())
  name String  @db.VarChar(32) // 类别名称
  type Boolean // 收支类型[0:收入:1支出]
  sort Int // 类别排序
  data String  @db.VarChar(256) // 备注信息

  @@map("is_iet")
}

model Often {
  id   Int    @id @default(autoincrement())
  user Int // 所属用户
  name String @db.VarChar(64) // 功能名称
  key  String @db.VarChar(32) // 功能标识

  @@map("is_often")
}

model Field {
  id     Int    @id @default(autoincrement())
  name   String @db.VarChar(32) // 模块名称
  key    String @db.VarChar(32) // 模块标识
  data   String @db.VarChar(256) // 备注信息
  fields String @db.Text // 字段数据

  @@map("is_field")
}

model Entry {
  id        Int     @id @default(autoincrement())
  frame     Int // 所属组织
  supplier  Int?    @default(0) // 供应商
  time      Int // 单据时间
  number    String  @db.VarChar(32) // 单据编号
  type      Boolean // 单据类型[0:其它入库单|1:盘盈单]
  total     Decimal @db.Decimal(16, 4) // 单据金额
  people    Int?    @default(0) // 关联人员
  logistics String? @db.Text // 物流信息
  file      String? @db.Text // 单据附件
  data      String? @default("") @db.VarChar(256) // 备注信息
  more      String? @db.Text // 扩展信息
  examine   Boolean // 审核状态
  cse       Int     @default(0) @db.SmallInt // 费用状态[0:未结算|1:部分结算|2:已结算|3:无需结算]
  check     Boolean // 核对状态
  user      Int // 制单人

  @@map("is_entry")
}

model EntryInfo {
  id        Int     @id @default(autoincrement())
  pid       Int // 所属单据
  goods     Int // 所属商品
  attr      String? @default("") @db.VarChar(64) // 辅助属性
  unit      String? @default("") @db.VarChar(32) // 商品单位
  warehouse Int?    @default(0) // 所属仓库
  batch     String? @default("") @db.VarChar(64) // 批次号
  mfd       Int?    @default(0) // 生产日期
  price     Decimal @db.Decimal(12, 4) // 成本
  nums      Decimal @db.Decimal(12, 4) // 数量
  serial    String? @db.Text // 序列号
  total     Decimal @db.Decimal(16, 4) // 总成本
  data      String? @default("") @db.VarChar(256) // 备注信息

  @@map("is_entry_info")
}

model Cost {
  id     Int     @id @default(autoincrement())
  type   String  @db.VarChar(32) // 单据类型
  class  Int // 所属单据
  iet    Int // 收支类型
  time   Int // 费用时间
  money  Decimal @db.Decimal(16, 4) // 费用金额
  settle Decimal @db.Decimal(16, 4) // 结算金额
  state  Int     @default(0) @db.SmallInt // 结算状态[0:未结算|1:部分结算|2:已结算]
  data   String? @default("") @db.VarChar(256) // 备注信息

  @@map("is_cost")
}

model People {
  id     Int     @id @default(autoincrement())
  name   String  @db.VarChar(32) // 人员名称
  py     String  @db.VarChar(32) // 拼音信息
  number String  @db.VarChar(32) // 人员编号
  frame  Int // 所属组织
  sex    Boolean // 性别[0:女|1:男]
  tel    String? @default("") @db.VarChar(32) // 手机号码
  card   String? @default("") @db.VarChar(32) // 身份证号
  add    String? @default("") @db.VarChar(64) // 联系地址
  data   String? @default("") @db.VarChar(256) // 备注信息
  more   String? @db.Text // 扩展信息

  @@map("is_people")
}

model Attribute {
