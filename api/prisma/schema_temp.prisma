generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id     Int     @id @default(autoincrement())
  name   String  @db.VarChar(32)
  py     String  @db.VarChar(32)
  tel    String  @db.VarChar(11)
  frame  Int
  role   Int
  user   String  @db.VarChar(32)
  pwd    String  @db.VarChar(32)
  img    String  @db.Text
  token  String? @default("") @db.VarChar(32)
  expire Int
  data   String  @db.VarChar(256)
  more   String  @db.Text

  @@index([expire], map: "expire")
  @@index([frame], map: "frame")
  @@index([name, py], map: "name_py")
  @@index([role], map: "role")
  @@index([tel], map: "tel")
  @@index([user], map: "user")
  @@map("is_user")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(32)
  data String @db.VarChar(256)
  root String @db.Text
  auth String @db.Text

  @@index([name], map: "name")
  @@map("is_role")
}

model Menu {
  id       Int     @id @default(autoincrement())
  pid      Int
  name     String  @db.VarChar(32)
  key      String  @db.VarChar(32)
  model    Boolean
  type     Boolean
  resource String  @db.VarChar(128)
  sort     Int?    @default(0)
  ico      String  @db.VarChar(32)
  root     String  @db.VarChar(32)
  data     String  @db.VarChar(256)

  @@index([model], map: "model")
  @@index([name], map: "name")
  @@index([pid], map: "pid")
  @@index([sort], map: "sort")
  @@index([type], map: "type")
  @@map("is_menu")
}

model Code {
  id   Int     @id @default(autoincrement())
  name String  @db.VarChar(32)
  info String  @db.VarChar(64)
  type Boolean
  data String  @db.VarChar(256)

  @@index([type], map: "type")
  @@map("is_code")
}

model Sys {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(32)
  info String @db.Text
  data String @db.VarChar(256)

  @@index([name], map: "name")
  @@map("is_sys")
}

model Customer {
  id       Int      @id @default(autoincrement())
  name     String   @db.VarChar(32)
  py       String   @db.VarChar(32)
  number   String   @db.VarChar(32)
  frame    Int
  user     Int
  category String   @db.VarChar(32)
  grade    String   @db.VarChar(32)
  bank     String   @db.VarChar(32)
  account  String   @db.VarChar(64)
  tax      String   @db.VarChar(64)
  data     String   @db.VarChar(256)
  contacts String   @db.Text
  balance  Decimal? @default(0.0000) @db.Decimal(16, 4)
  more     String   @db.Text

  @@index([frame], map: "frame")
  @@index([name], map: "name")
  @@index([user], map: "user")
  @@map("is_customer")
}

model Supplier {
  id       Int      @id @default(autoincrement())
  name     String   @db.VarChar(32)
  py       String   @db.VarChar(32)
  number   String   @db.VarChar(32)
  frame    Int
  user     Int
  category String   @db.VarChar(32)
  rate     Decimal  @db.Decimal(5, 2)
  bank     String   @db.VarChar(32)
  account  String   @db.VarChar(64)
  tax      String   @db.VarChar(64)
  data     String   @db.VarChar(256)
  contacts String   @db.Text
  balance  Decimal? @default(0.0000) @db.Decimal(16, 4)
  more     String   @db.Text

  @@index([frame], map: "frame")
  @@index([name, py], map: "name_py")
  @@index([user], map: "user")
  @@map("is_supplier")
}

model Goods {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(32)
  py        String   @db.VarChar(32)
  number    String   @db.VarChar(32)
  spec      String   @db.VarChar(32)
  category  Int
  brand     String   @db.VarChar(32)
  unit      String   @db.VarChar(32)
  buy       Decimal  @db.Decimal(12, 4)
  sell      Decimal  @db.Decimal(12, 4)
  code      String   @db.VarChar(64)
  location  String   @db.VarChar(64)
  stock     Decimal  @db.Decimal(12, 4)
  type      Boolean
  data      String   @db.VarChar(256)
  imgs      String   @db.Text
  details   String   @db.Text
  units     String   @db.Text
  strategy  String   @db.Text
  serial    Boolean? @default(false)
  batch     Boolean? @default(false)
  validity  Boolean? @default(false)
  protect   Int?     @default(0) @db.SmallInt
  threshold Int?     @default(0) @db.SmallInt
  more      String   @db.Text

  @@index([brand], map: "brand")
  @@index([category], map: "category")
  @@index([code], map: "code")
  @@index([name, py], map: "name_py")
  @@index([number], map: "number")
  @@index([type], map: "type")
  @@map("is_goods")
}

model Warehouse {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(32)
  number   String @db.VarChar(32)
  frame    Int
  contacts String @db.VarChar(32)
  tel      String @db.VarChar(32)
  add      String @db.VarChar(64)
  data     String @db.VarChar(256)

  @@index([frame], map: "frame")
  @@index([name], map: "name")
  @@map("is_warehouse")
}

model Account {
  id      Int      @id @default(autoincrement())
  name    String   @db.VarChar(32)
  number  String   @db.VarChar(32)
  frame   Int
  time    Int
  initial Decimal  @db.Decimal(16, 4)
  balance Decimal? @default(0.0000) @db.Decimal(16, 4)
  data    String?  @default("") @db.VarChar(256)

  @@index([frame], map: "frame")
  @@map("is_account")
}

model Room {
  id        Int     @id @default(autoincrement())
  warehouse Int
  goods     Int
  attr      String  @db.VarChar(64)
  nums      Decimal @db.Decimal(12, 4)

  @@index([goods], map: "goods")
  @@index([warehouse], map: "warehouse")
  @@map("is_room")
}

model Batch {
  id        Int     @id @default(autoincrement())
  room      Int
