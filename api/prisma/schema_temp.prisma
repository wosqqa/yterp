  @@index([goods], map: "goods")
  @@index([room], map: "room")
  @@index([time], map: "time")
  @@index([warehouse], map: "warehouse")
  @@map("is_batch")
}

model Sell {
  id        Int     @id @default(autoincrement())
  source    Int
  frame     Int
  customer  Int
  time      Int
  number    String  @db.VarChar(32)
  total     Decimal @db.Decimal(16, 4)
  actual    Decimal @db.Decimal(16, 4)
  money     Decimal @db.Decimal(16, 4)
  cost      Decimal @db.Decimal(16, 4)
  account   Int?    @default(0)
  people    Int?    @default(0)
  logistics String? @db.Text
  file      String? @db.Text
  data      String? @default("") @db.VarChar(256)
  more      String? @db.Text
  examine   Boolean
  nucleus   Boolean
  cse       Boolean
  invoice   Boolean
  check     Boolean
  user      Int

  @@index([account], map: "account")
  @@index([check], map: "check")
  @@index([cse], map: "cse")
  @@index([examine], map: "examine")
  @@index([frame], map: "frame")
  @@index([invoice], map: "invoice")
  @@index([nucleus], map: "nucleus")
  @@index([people], map: "people")
  @@index([customer], map: "supplier")
  @@index([time], map: "time")
  @@index([user], map: "user")
  @@map("is_sell")
}

